# 审计 Agent 配置示例
# 使用方式：复制为 .env 后按本地环境修改。不要把真实 .env 提交到 GitHub。

# 企业信息来源：
# mock：本地模拟数据
# website：从员工 Excel 中的企业官网超链接爬取
# qichacha：企查查 API
COMPANY_PROVIDER=website

# 控制台日志级别：DEBUG / INFO / WARNING / ERROR
AUDIT_LOG_LEVEL=INFO

# 本地上传、导出、缓存目录
AUDIT_STORAGE_DIR=storage

# 官网爬取配置
WEBSITE_CRAWL_MAX_PAGES=4
WEBSITE_CRAWL_MAX_DEPTH=2
WEBSITE_CRAWL_TIMEOUT=8
WEBSITE_CRAWL_CONCURRENCY=5
WEBSITE_CRAWL_TARGET_MODULES=公司简介,经典案例,业务领域
WEBSITE_CACHE_PATH=storage/cache/website_cache.json

# 企查查 API 配置；当前暂停企查查时可以留空
QICHACHA_API_KEY=
QICHACHA_API_SECRET=
QICHACHA_ENDPOINT=https://api.qichacha.com/ECIV4/GetBasicDetailsByName
QICHACHA_SEARCH_PARAM=keyword
QICHACHA_TIMEOUT=15
